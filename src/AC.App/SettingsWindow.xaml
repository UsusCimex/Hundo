<Window x:Class="AC.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AC.App"
        Title="{local:Tr settings.title}" Icon="Assets/app.ico" Width="640" Height="760" MinHeight="480" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AutomationProperties.AutomationId="Settings">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{local:Tr settings.cancel}" IsCancel="True" AutomationProperties.AutomationId="CancelButton" Margin="0,0,8,0" Padding="16,5" />
                <Button Content="{local:Tr settings.save}" IsDefault="True" AutomationProperties.AutomationId="SaveButton" Click="OnSave" Padding="16,5" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="{local:Tr settings.title}" Style="{StaticResource Title}" Margin="0,0,0,12" />

                <!-- Steam -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Steam" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />

                        <TextBlock Text="{local:Tr settings.apiKey}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{local:Tr settings.getKey}" Margin="8,0,0,0" Click="OnGetKey" />
                            <PasswordBox x:Name="ApiKeyBox" />
                        </DockPanel>

                        <TextBlock Text="SteamID64" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{local:Tr settings.detectId}" Margin="8,0,0,0" Click="OnDetectSteamId" />
                            <TextBox x:Name="SteamIdBox" />
                        </DockPanel>

                        <TextBlock Text="{local:Tr settings.language}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                        <ComboBox x:Name="LanguageBox" ItemsSource="{x:Static local:Options.ContentLanguages}" DisplayMemberPath="Title" HorizontalAlignment="Stretch" />

                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="{local:Tr settings.steamHint}" />
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{local:Tr settings.statusTitle}" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                        <ComboBox x:Name="StatusSourceBox" ItemsSource="{x:Static local:Options.StatusSources}" DisplayMemberPath="Title" HorizontalAlignment="Stretch" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,10"
                                   Text="{local:Tr settings.statusHint}" />
                        <TextBlock Text="{local:Tr settings.poll}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                        <TextBox x:Name="PollBox" Width="90" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Manual marks and Steam writes -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{local:Tr settings.manualTitle}" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                        <CheckBox x:Name="ManualUnlocksBox" Content="{local:Tr settings.manualToggle}"
                                  Click="OnManualUnlocksClick" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{local:Tr settings.manualHint}" />
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsChecked, ElementName=ManualUnlocksBox, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{local:Tr settings.writeMode}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                            <ComboBox x:Name="WriteModeBox" ItemsSource="{x:Static local:Options.WriteModes}" DisplayMemberPath="Title" HorizontalAlignment="Stretch" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{local:Tr settings.writeHint}" />
                            <CheckBox x:Name="AutoMarkBox" Content="{local:Tr settings.autoMark}" Margin="0,12,0,0"
                                      Click="OnAutoMarkClick" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="{local:Tr settings.autoMarkHint}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Display -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{local:Tr settings.viewTitle}" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                        <TextBlock Text="{local:Tr settings.uiLanguage}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                        <ComboBox x:Name="UiLanguageBox" ItemsSource="{x:Static local:Options.UiLanguages}" DisplayMemberPath="Title"
                                  Width="220" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <TextBlock Text="{local:Tr settings.theme}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                        <ComboBox x:Name="ThemeBox" ItemsSource="{x:Static local:Options.Themes}" DisplayMemberPath="Title"
                                  Width="220" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <CheckBox x:Name="HideSpoilersBox" Content="{local:Tr settings.hideSpoilers}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{local:Tr settings.spoilersHint}" />
                    </StackPanel>
                </Border>

                <!-- Overlay -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{local:Tr settings.overlayTitle}" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{local:Tr settings.toggleKey}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                <TextBox x:Name="ToggleHotkeyBox" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{local:Tr settings.interactKey}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                <TextBox x:Name="InteractHotkeyBox" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{local:Tr settings.opacity}" Style="{StaticResource Caption}" Margin="0,10,0,2" />
                        <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" />
                        <TextBlock Text="{local:Tr settings.nearest}" Style="{StaticResource Caption}" Margin="0,10,0,2" />
                        <TextBox x:Name="NearestBox" Width="90" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{local:Tr settings.overlayHint}" />
                    </StackPanel>
                </Border>

                <!-- Data -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{local:Tr settings.dataTitle}" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{local:Tr settings.openData}" Margin="8,0,0,0" Click="OnOpenDataDir" />
                            <TextBox x:Name="DataDirBox" IsReadOnly="True" />
                        </DockPanel>
                        <TextBlock x:Name="DataDirHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{local:Tr settings.updatesTitle}" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                        <CheckBox x:Name="CheckUpdatesBox" Content="{local:Tr settings.checkUpdates}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{local:Tr settings.updatesHint}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
