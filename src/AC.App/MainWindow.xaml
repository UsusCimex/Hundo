<Window x:Class="AC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AC.App"
        xmlns:core="clr-namespace:AC.Core;assembly=AC.Core"
        Title="Hundo" Icon="Assets/app.ico"
        Width="1360" Height="880" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Selection is an accent ring on top, no fill: the theme fill clashes with the card background. -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" IsHitTestVisible="False" Visibility="Collapsed"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="14" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A hidden achievement's text is blurred; a button on top reveals it. -->
        <Style x:Key="SpoilerText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSpoilerHidden}" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <BlurEffect Radius="9" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Past the estimate: the time left has the wide margin, or there is none. -->
        <Style x:Key="LateCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLate}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLate}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SpoilerTip" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTipHidden}" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <BlurEffect Radius="9" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SpoilerPictures" TargetType="ItemsControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTipHidden}" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <BlurEffect Radius="12" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PictureThumb" TargetType="Button">
            <Setter Property="Margin" Value="0,6,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevealButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{local:Tr card.revealTip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <Border x:Name="Pill" HorizontalAlignment="Left" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" CornerRadius="10" Padding="8,2" BorderThickness="1"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{local:Tr card.reveal}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RarityPercent" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RarityLevel}" Value="4">
                    <Setter Property="Foreground" Value="{DynamicResource RarityVeryRareBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RarityLevel}" Value="3">
                    <Setter Property="Foreground" Value="{DynamicResource RarityRareBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RarityLevel}" Value="2">
                    <Setter Property="Foreground" Value="{DynamicResource RarityUncommonBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusStripe" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsManualStatus}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsManualStatus}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Card actions show on hover and when selected; their space is always reserved so the list does not jump. -->
        <Style x:Key="CardActions" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeroTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <DataTemplate x:Key="AchievementCard">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="7,0,0,7" Style="{StaticResource StatusStripe}" />

                <Grid Grid.Column="1" Margin="12,12,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Width="48" Height="48" CornerRadius="6" VerticalAlignment="Top"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Border CornerRadius="6" local:RemoteImage.DecodeWidth="96" local:RemoteImage.Url="{Binding Icon}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Grid Margin="0,2,0,0" Visibility="{Binding Description, Converter={StaticResource EmptyToCollapsed}}">
                            <TextBlock Text="{Binding Description}" Style="{StaticResource SpoilerText}" />
                            <Button Style="{StaticResource RevealButton}" Command="{Binding RevealCommand}"
                                    Visibility="{Binding IsSpoilerHidden, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Note, Converter={StaticResource EmptyToCollapsed}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" MinWidth="120">
                        <TextBlock Text="{Binding Percent}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Style="{StaticResource RarityPercent}" />
                        <TextBlock Text="{Binding RarityText}" HorizontalAlignment="Right" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0" ToolTip="{Binding EstimateHint}"
                                    Visibility="{Binding Estimate, Converter={StaticResource EmptyToCollapsed}}">
                            <TextBlock Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,4,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Estimate}" Style="{StaticResource LateCaption}" />
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusPill}" Margin="0,0,6,0" VerticalAlignment="Center"
                                Visibility="{Binding StatusText, Converter={StaticResource EmptyToCollapsed}}">
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Visibility="{Binding HasKind, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding KindTitle}" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Visibility="{Binding Group, Converter={StaticResource EmptyToCollapsed}}">
                            <TextBlock Text="{Binding Group}" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{local:Tr card.hidden}" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                Visibility="{Binding IsProbablyMissed, Converter={StaticResource BoolToVis}}" ToolTip="{local:Tr card.missedTip}">
                            <TextBlock Text="{local:Tr card.missed}" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}"
                                ToolTip="{local:Tr card.protectedTip}">
                            <TextBlock Text="{local:Tr card.protected}" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Visibility="{Binding IsPendingWrite, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{local:Tr card.queued}" Style="{StaticResource ChipText}" />
                        </Border>
                    </WrapPanel>

                    <Border Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,0"
                            Visibility="{Binding DataContext.ManualUnlocks, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <StackPanel Style="{StaticResource CardActions}" Orientation="Horizontal">
                            <CheckBox Content="{local:Tr card.done}" MinWidth="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                      IsChecked="{Binding ManualDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding IsUnlocked, Converter={StaticResource InverseVis}}"
                                      ToolTip="{local:Tr card.doneTip}" />
                            <Button Content="{local:Tr card.toSteam}" Padding="10,3"
                                    ToolTip="{local:Tr card.toSteamTip}"
                                    Command="{Binding DataContext.UnlockInSteamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanWriteToSteam, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PlanItem">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <CheckBox MinWidth="0" VerticalAlignment="Center" Margin="0,0,4,0"
                          IsChecked="{Binding ManualDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding DataContext.ManualUnlocks, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                          ToolTip="{local:Tr plan.doneTip}" />
                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="4" VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <Border CornerRadius="4" local:RemoteImage.DecodeWidth="64" local:RemoteImage.Url="{Binding Icon}" />
                </Border>
                <StackPanel Grid.Column="2" Margin="8,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{local:Tr card.missed}" Style="{StaticResource Caption}" ToolTip="{local:Tr card.missedTip}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding IsProbablyMissed, Converter={StaticResource BoolToVis}}" />
                    <Grid Visibility="{Binding Description, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Text="{Binding Description}" FontSize="12" Style="{StaticResource SpoilerText}" />
                        <Button Style="{StaticResource RevealButton}" Command="{Binding RevealCommand}"
                                Visibility="{Binding IsSpoilerHidden, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding Estimate}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           ToolTip="{Binding EstimateHint}" Style="{StaticResource LateText}" />
                <TextBlock Grid.Column="4" Text="{Binding Percent}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource RarityPercent}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Hundo" Style="{StaticResource Subtitle}" />
                    <TextBlock Text="{local:Tr library.tagline}" Style="{StaticResource Caption}" Margin="0,2,0,14" />
                    <Grid Margin="0,0,0,10">
                        <TextBox x:Name="LibrarySearch" Padding="32,5,6,6" Text="{Binding LibraryFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{local:Tr library.search}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding Text, ElementName=LibrarySearch, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
                    </Grid>
                    <DockPanel Margin="0,0,0,10">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource FilterChip}" Margin="8,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding LibraryStartedOnly}" ToolTip="{local:Tr library.startedTip}"
                                      AutomationProperties.AutomationId="LibraryStarted">
                            <TextBlock Text="{local:Tr library.started}" />
                        </ToggleButton>
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static local:Options.LibrarySorts}" DisplayMemberPath="Title"
                                  SelectedItem="{Binding SelectedLibrarySort}" AutomationProperties.AutomationId="LibrarySort" />
                    </DockPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="{local:Tr library.openByAppId}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{local:Tr library.open}" Margin="8,0,0,0" Command="{Binding LoadAppIdCommand}" />
                        <TextBox Text="{Binding AppIdInput, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Button HorizontalAlignment="Stretch" Margin="0,0,0,8" Command="{Binding RefreshLibraryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                            <TextBlock Text="{local:Tr library.refresh}" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="OnOpenSettings" AutomationProperties.AutomationId="SettingsButton">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                            <TextBlock Text="{local:Tr settings.title}" />
                        </StackPanel>
                    </Button>
                    <CheckBox Content="{local:Tr library.follow}" IsChecked="{Binding AutoFollow}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding LibraryView}" SelectedItem="{Binding SelectedLibraryGame}" HorizontalContentAlignment="Stretch"
                         Background="Transparent" BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="92" Height="43" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Border CornerRadius="4" local:RemoteImage.DecodeWidth="184" local:RemoteImage.Url="{Binding HeaderUrl}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <DockPanel Margin="0,1,0,0">
                                        <Border DockPanel.Dock="Right" CornerRadius="8" Padding="6,0" Margin="6,0,0,0"
                                                Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                                Visibility="{Binding IsPerfect, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="100%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Caption}" FontSize="11" Margin="6,0,0,0"
                                                   Visibility="{Binding ShowProgressText, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <Grid Height="3" Margin="0,4,0,0" Visibility="{Binding ShowProgressText, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding DoneStars}" />
                                            <ColumnDefinition Width="{Binding RestStars}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" CornerRadius="1.5" Background="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                        <Border CornerRadius="1.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24,20,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasGame, Converter={StaticResource InverseVis}}">
                <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{local:Tr empty.title}" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="{local:Tr empty.hint}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding HasApiKey, Converter={StaticResource InverseVis}}">
                    <TextBlock Text="{local:Tr empty.needKey}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" />
                    <Button Content="{local:Tr empty.openSettings}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnOpenSettings"
                            Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Header: the wide game image under a dark overlay so white text reads on any art -->
            <Grid Grid.Row="0" Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="10" Background="#141A23" />
                <Border CornerRadius="10" local:RemoteImage.DecodeWidth="1600" local:RemoteImage.Url="{Binding HeroImageUrl}" />
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F2141A23" Offset="0" />
                            <GradientStop Color="#CC141A23" Offset="0.55" />
                            <GradientStop Color="#66141A23" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="276" Height="129" CornerRadius="6" VerticalAlignment="Top" Background="#22FFFFFF">
                        <Border CornerRadius="6" local:RemoteImage.DecodeWidth="0" local:RemoteImage.Url="{Binding HeaderImageUrl}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="{Binding GameName}" FontSize="26" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                        <!-- Three-part progress: unlocked in Steam, done but not counted, remaining -->
                        <Grid Height="6" Margin="0,10,0,4" ToolTip="{Binding ProgressText}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding SegUnlocked}" />
                                <ColumnDefinition Width="{Binding SegManual}" />
                                <ColumnDefinition Width="{Binding SegRest}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="3" CornerRadius="3" Background="#33FFFFFF" />
                            <Border Grid.ColumnSpan="2" CornerRadius="3" Background="#D29922" />
                            <Border CornerRadius="3" Background="#66C0F4" />
                        </Grid>
                        <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#C7D0DA" TextWrapping="Wrap" />

                        <UniformGrid Columns="3" Margin="0,12,0,0">
                            <Border Style="{StaticResource HeroTile}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr game.unlocked}" FontSize="12" Foreground="#AEB8C4" />
                                    <TextBlock Text="{Binding StatUnlocked}" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding StatUnlockedSub}" FontSize="12" Foreground="#AEB8C4" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HeroTile}" Margin="0,0,8,0" ToolTip="{Binding RemainingText}">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr game.toComplete}" FontSize="12" Foreground="#AEB8C4" />
                                    <TextBlock Text="{Binding StatRemaining}" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding StatRemainingSub}" FontSize="12" Foreground="#AEB8C4" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HeroTile}">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr game.played}" FontSize="12" Foreground="#AEB8C4" />
                                    <TextBlock Text="{Binding StatPlayed}" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding StatPlayedSub}" FontSize="12" Foreground="#AEB8C4" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0" AutomationProperties.AutomationId="SessionSummary"
                    Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Padding="8,5" Margin="12,0,0,0" Command="{Binding CloseSessionCommand}"
                            ToolTip="{local:Tr session.close}" AutomationProperties.AutomationId="CloseSession">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10" />
                    </Button>
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,1,14,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel>
                        <TextBlock Text="{Binding SessionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding SessionUnlocked}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding SessionLeft}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Visibility="{Binding SessionLeft, Converter={StaticResource EmptyToCollapsed}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <WrapPanel Grid.Row="2" Margin="0,12,0,4" Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                <Button Margin="0,0,8,8" Padding="12,6" Command="{Binding RefreshStateCommand}" Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="{local:Tr toolbar.refreshTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="{local:Tr toolbar.refresh}" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Padding="12,6" Click="OnToggleOverlay" AutomationProperties.AutomationId="OverlayButton"
                        ToolTip="{local:Tr toolbar.overlayTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="{local:Tr toolbar.overlay}" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Padding="12,6" Command="{Binding FlushQueueCommand}"
                        Visibility="{Binding QueueVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding QueueText}" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Padding="12,6" Click="OnDropDown" AutomationProperties.AutomationId="MoreButton">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{local:Tr toolbar.more}" />
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="10" Margin="8,1,0,0" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{local:Tr menu.reload}" Command="{Binding ReloadCommand}"
                                      ToolTip="{local:Tr menu.reloadTip}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{local:Tr menu.readClient}" Command="{Binding ReadViaBridgeCommand}"
                                      ToolTip="{local:Tr menu.readClientTip}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{local:Tr menu.export}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" />
                                </MenuItem.Icon>
                                <MenuItem Header="{local:Tr menu.exportManualCsv}" Command="{Binding ExportCsvCommand}" CommandParameter="manual"
                                          Visibility="{Binding ManualUnlocks, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="{local:Tr menu.exportManualJson}" Command="{Binding ExportJsonCommand}" CommandParameter="manual"
                                          Visibility="{Binding ManualUnlocks, Converter={StaticResource BoolToVis}}" />
                                <Separator Visibility="{Binding ManualUnlocks, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="{local:Tr menu.exportAllCsv}" Command="{Binding ExportCsvCommand}" CommandParameter="all" />
                                <MenuItem Header="{local:Tr menu.exportAllJson}" Command="{Binding ExportJsonCommand}" CommandParameter="all" />
                            </MenuItem>
                            <MenuItem Header="{local:Tr menu.tags}">
                                <MenuItem Header="{local:Tr menu.tagsSave}" Command="{Binding ExportTagsCommand}" />
                                <MenuItem Header="{local:Tr menu.tagsLoad}" Command="{Binding ImportTagsCommand}" />
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>

            <TabControl Grid.Row="3" Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                <TabItem Header="{local:Tr tabs.achievements}" AutomationProperties.AutomationId="AchievementsTab">
                    <DockPanel Margin="0,10,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                            <Grid Width="260" Margin="0,0,12,8">
                                <TextBox x:Name="SearchBox" Padding="32,5,6,6"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{local:Tr list.search}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
                            </Grid>
                            <ComboBox Width="140" Margin="0,0,8,8" ToolTip="{local:Tr list.kindTip}" ItemsSource="{x:Static local:Options.KindFilters}" DisplayMemberPath="Title"
                                      SelectedItem="{Binding KindFilter}" />
                            <ComboBox Width="190" Margin="0,0,4,8" ToolTip="{local:Tr list.sortTip}" ItemsSource="{x:Static local:Options.Sorts}" DisplayMemberPath="Title" AutomationProperties.AutomationId="SortBox"
                                      SelectedItem="{Binding SelectedSort}" />
                            <ToggleButton Margin="0,0,8,8" Padding="9,7" IsChecked="{Binding Descending}" ToolTip="{local:Tr list.reverseTip}">
                                <TextBlock Text="&#xE8CB;" Style="{StaticResource Glyph}" />
                            </ToggleButton>
                            <ComboBox Width="160" Margin="0,0,8,8" ItemsSource="{x:Static local:Options.Percentiles}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedPercentile}"
                                      ToolTip="{local:Tr list.percentileTip}" />
                            <ComboBox Width="150" Margin="0,0,0,8" ItemsSource="{x:Static local:Options.HourModes}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedHours}"
                                      ToolTip="{local:Tr list.hoursTip}" AutomationProperties.AutomationId="HoursBox" />
                        </DockPanel>

                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <RadioButton Style="{StaticResource FilterChip}"
                                         IsChecked="{Binding Status, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static core:StatusFilter.All}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Tr list.all}" />
                                    <TextBlock Text="{Binding CountAll}" Margin="6,0,0,0" Opacity="0.7" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FilterChip}"
                                         IsChecked="{Binding Status, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static core:StatusFilter.Open}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Tr list.open}" />
                                    <TextBlock Text="{Binding CountOpen}" Margin="6,0,0,0" Opacity="0.7" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FilterChip}"
                                         IsChecked="{Binding Status, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static core:StatusFilter.Done}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Tr list.done}" />
                                    <TextBlock Text="{Binding CountDone}" Margin="6,0,0,0" Opacity="0.7" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FilterChip}" ToolTip="{local:Tr list.notCountedTip}"
                                         Visibility="{Binding ManualUnlocks, Converter={StaticResource BoolToVis}}"
                                         IsChecked="{Binding Status, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static core:StatusFilter.NotCounted}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Tr list.notCounted}" />
                                    <TextBlock Text="{Binding CountNotCounted}" Margin="6,0,0,0" Opacity="0.7" />
                                </StackPanel>
                            </RadioButton>
                            <Border Width="1" Margin="6,4,12,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding OnlyHidden}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{local:Tr list.hidden}" />
                                </StackPanel>
                            </ToggleButton>
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="340" />
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="AchievementList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                                     ItemTemplate="{StaticResource AchievementCard}" ItemContainerStyle="{StaticResource CardItem}"
                                     ContextMenuOpening="OnAchievementMenuOpening"
                                     SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{local:Tr list.menuWrite}"
                                                  Command="{Binding UnlockInSteamCommand}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="{local:Tr list.menuRevert}"
                                                  Command="{Binding RevertCommand}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>

                            <TextBlock Text="{local:Tr list.empty}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
                                <TextBlock.Visibility>
                                    <Binding Path="Items.Count" ElementName="AchievementList">
                                        <Binding.Converter>
                                            <local:ZeroToVisibleConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Visibility>
                            </TextBlock>

                            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding HasSelectedRow, Converter={StaticResource InverseVis}}">
                                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="32" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{local:Tr details.empty}"
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedRow}"
                                                  Visibility="{Binding DataContext.HasSelectedRow, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <Border Width="64" Height="64" CornerRadius="8" HorizontalAlignment="Left"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <Border CornerRadius="8" local:RemoteImage.DecodeWidth="128" local:RemoteImage.Url="{Binding Icon}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,10,0,4" />
                                            <Grid Visibility="{Binding Description, Converter={StaticResource EmptyToCollapsed}}">
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource SpoilerText}" />
                                                <Button Style="{StaticResource RevealButton}" Command="{Binding RevealCommand}"
                                                        Visibility="{Binding IsSpoilerHidden, Converter={StaticResource BoolToVis}}" />
                                            </Grid>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{local:Tr details.percent}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                                    <Run Text="{Binding Percent, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding RarityText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Grid.Row="1" Text="{local:Tr details.estimate}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EstimateBoth}" Margin="0,0,0,6" TextWrapping="Wrap" ToolTip="{Binding EstimateHint}" />
                                                <TextBlock Grid.Row="2" Text="{local:Tr details.status}" Style="{StaticResource Caption}" Margin="0,0,0,6"
                                                           Visibility="{Binding StatusText, Converter={StaticResource EmptyToCollapsed}}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" Margin="0,0,0,6"
                                                           Visibility="{Binding StatusText, Converter={StaticResource EmptyToCollapsed}}" />
                                                <TextBlock Grid.Row="3" Text="{local:Tr details.apiName}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ApiName, Mode=OneWay}" IsReadOnly="True" />
                                            </Grid>

                                            <TextBlock Text="{local:Tr details.guides}" Style="{StaticResource Header}" Margin="0,16,0,6" />
                                            <StackPanel Margin="0,0,0,8" Visibility="{Binding HasGuideTip, Converter={StaticResource BoolToVis}}">
                                                <Grid Margin="0,0,0,4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding GuideText}" Style="{StaticResource SpoilerTip}"
                                                                   Visibility="{Binding GuideText, Converter={StaticResource EmptyToCollapsed}}" />
                                                        <ItemsControl ItemsSource="{Binding GuidePictures}" Style="{StaticResource SpoilerPictures}" Focusable="False">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource PictureThumb}" Click="OnOpenPicture" ToolTip="{local:Tr details.pictureTip}" AutomationProperties.AutomationId="GuidePicture"
                                                                            Visibility="{Binding IsShown, Converter={StaticResource BoolToVis}}">
                                                                        <Border Width="142" Height="80" CornerRadius="4">
                                                                            <Border.Background>
                                                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                                            </Border.Background>
                                                                        </Border>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <!-- Over the pictures too: a hidden one's pictures are spoilers as well. -->
                                                    <Button Style="{StaticResource RevealButton}" Command="{Binding RevealCommand}" VerticalContentAlignment="Top"
                                                            Visibility="{Binding IsTipHidden, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4"
                                                           Visibility="{Binding CanTranslate, Converter={StaticResource BoolToVis}}">
                                                    <Hyperlink Command="{Binding DataContext.TranslateTipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}" ToolTip="{local:Tr details.translateTip}">
                                                        <Run Text="{Binding TranslateLabel, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                                    <Hyperlink Command="{Binding DataContext.OpenGuideTipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}">
                                                        <Run Text="{Binding GuideSource, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </StackPanel>

                                            <WrapPanel>
                                                <Button Content="{local:Tr details.guideSteam}" Margin="0,0,8,8" Padding="10,4"
                                                        Command="{Binding DataContext.OpenGuideCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="steam" />
                                                <Button Content="{local:Tr details.guideDiscussions}" Margin="0,0,8,8" Padding="10,4"
                                                        Command="{Binding DataContext.OpenGuideCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="discussions" />
                                                <Button Content="YouTube" Margin="0,0,8,8" Padding="10,4"
                                                        Command="{Binding DataContext.OpenGuideCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="youtube" />
                                                <Button Content="Google" Margin="0,0,8,8" Padding="10,4"
                                                        Command="{Binding DataContext.OpenGuideCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="google" />
                                            </WrapPanel>

                                            <TextBlock Text="{local:Tr details.kind}" Style="{StaticResource Caption}" Margin="0,16,0,2" />
                                            <ComboBox ItemsSource="{x:Static local:Options.Kinds}" DisplayMemberPath="Title" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />

                                            <TextBlock Text="{local:Tr details.group}" Style="{StaticResource Caption}" Margin="0,10,0,2" />
                                            <TextBox Text="{Binding Group, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Text="{local:Tr details.groupAuto}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       Visibility="{Binding GroupIsAuto, Converter={StaticResource BoolToVis}}" />

                                            <TextBlock Text="{local:Tr details.ownEstimate}" Style="{StaticResource Caption}" Margin="0,10,0,2" />
                                            <TextBox Text="{Binding EstimateInput, UpdateSourceTrigger=LostFocus}" />

                                            <TextBlock Text="{local:Tr details.note}" Style="{StaticResource Caption}" Margin="0,10,0,2" />
                                            <TextBox Text="{Binding Note, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />

                                            <StackPanel Visibility="{Binding DataContext.ManualUnlocks, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <CheckBox Content="{local:Tr details.done}" Margin="0,12,0,8"
                                                          IsChecked="{Binding ManualDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding IsUnlocked, Converter={StaticResource InverseVis}}" />
                                                <WrapPanel>
                                                    <Button Content="{local:Tr details.write}" Margin="0,0,8,8" Padding="12,5"
                                                            Command="{Binding DataContext.UnlockInSteamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanWriteToSteam, Converter={StaticResource BoolToVis}}" />
                                                    <Button Content="{local:Tr details.revert}" Margin="0,0,8,8" Padding="12,5"
                                                            Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{local:Tr tabs.plan}" AutomationProperties.AutomationId="PlanTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PlanHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12" />
                            <ItemsControl ItemsSource="{Binding PlanSections}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Header}" />
                                            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <DockPanel Margin="0,0,0,4">
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Longest}" Style="{StaticResource Caption}" />
                                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                </DockPanel>
                                                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PlanItem}" Focusable="False" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{local:Tr tabs.time}" AutomationProperties.AutomationId="TimeTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr time.sampleTitle}" Style="{StaticResource Subtitle}" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                                               Text="{local:Tr time.sampleHint}" />
                                    <DockPanel Margin="0,0,0,10" Visibility="{Binding HasApiKey, Converter={StaticResource InverseVis}}">
                                        <Button DockPanel.Dock="Right" Content="{local:Tr settings.title}" Margin="8,0,0,0" Click="OnOpenSettings" />
                                        <TextBlock Text="{local:Tr time.needKey}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DockPanel>
                                    <WrapPanel>
                                        <Button Content="{local:Tr time.collect}" Margin="0,0,8,8" Padding="12,5" Command="{Binding CollectSampleCommand}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding SampleText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr time.completionTitle}" Style="{StaticResource Subtitle}" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                                               Text="{local:Tr time.completionHint}" />
                                    <WrapPanel>
                                        <TextBox Width="90" Text="{Binding CompletionInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8" />
                                        <TextBlock Text="{local:Tr time.hours}" VerticalAlignment="Center" Margin="0,0,16,8" Style="{StaticResource Muted}" />
                                        <Button Content="{local:Tr time.apply}" Margin="0,0,8,8" Command="{Binding ApplyCompletionCommand}" />
                                        <Button Content="{local:Tr time.fetch}" Margin="0,0,8,8" Command="{Binding FetchCompletionCommand}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding CompletionText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{local:Tr time.playtimeTitle}" Style="{StaticResource Subtitle}" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                                               Text="{local:Tr time.playtimeHint}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{local:Tr time.override}" VerticalAlignment="Center" Margin="0,0,0,8"
                                                   ToolTip="{local:Tr time.overrideTip}" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Width="90" Margin="0,0,0,8"
                                                 Text="{Binding PlaytimeOverrideInput, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="1" Text="{local:Tr time.offset}" VerticalAlignment="Center" Margin="0,0,0,8"
                                                   ToolTip="{local:Tr time.offsetTip}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Width="90" Margin="0,0,0,8"
                                                 Text="{Binding PlaytimeOffsetInput, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Row="2" Grid.Column="1" Content="{local:Tr time.apply}" HorizontalAlignment="Left"
                                                Command="{Binding ApplyPlaytimeCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{local:Tr tabs.history}" AutomationProperties.AutomationId="HistoryTab">
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="{local:Tr history.empty}" Style="{StaticResource Muted}"
                                   Visibility="{Binding HasHistory, Converter={StaticResource InverseVis}}" />
                        <DockPanel MaxWidth="980" HorizontalAlignment="Left" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                            <local:UnlockChart DockPanel.Dock="Top" Height="230" Margin="0,0,0,16" AutomationProperties.AutomationId="UnlockChart"
                                               Days="{Binding HistoryDays}" Total="{Binding CountAll}"
                                               Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                               GridBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                               TextBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                               LabelBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                               SurfaceBrush="{DynamicResource ApplicationBackgroundBrush}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding HistoryRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Date}" Style="{StaticResource Muted}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Names}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <DockPanel Grid.Row="4" Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding UpdateText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="UpdateButton" Content="{local:Tr update.download}" Command="{Binding DownloadUpdateCommand}"
                            Style="{DynamicResource AccentButtonStyle}" Padding="10,2" />
                    <Button x:Name="UpdateNotesButton" Content="{local:Tr update.notes}" Command="{Binding UpdateNotesCommand}"
                            Padding="10,2" Margin="6,0,0,0" />
                </StackPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
