<Window x:Class="AC.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AC.App"
        Title="{local:Tr overlay.title}" AutomationProperties.AutomationId="Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" MaxWidth="480" Foreground="White">
    <!-- The overlay is always dark: over a game, a light panel is blinding. -->
    <Window.Resources>
        <SolidColorBrush x:Key="OvText" Color="#F2F2F2" />
        <SolidColorBrush x:Key="OvMuted" Color="#A8B0BA" />
        <SolidColorBrush x:Key="OvLine" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="OvAccent" Color="#66C0F4" />
        <SolidColorBrush x:Key="OvWarn" Color="#FFB37A" />
        <SolidColorBrush x:Key="OvManual" Color="#D29922" />
        <SolidColorBrush x:Key="OvPill" Color="#26FFFFFF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OvText}" />
        </Style>

        <!-- Flat overlay button: own template so it does not depend on the app theme. -->
        <Style x:Key="OvButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource OvText}" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5566C0F4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OvProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border Background="{StaticResource OvPill}" CornerRadius="1.5" />
                            <Border x:Name="PART_Indicator" Background="{StaticResource OvAccent}" CornerRadius="1.5" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="OverlayItem">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="4" VerticalAlignment="Top" Background="{StaticResource OvPill}">
                    <Border CornerRadius="4" local:RemoteImage.DecodeWidth="56" local:RemoteImage.Url="{Binding Icon}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <!-- A hidden one's text is blurred like in the main window; in click mode hovering shows it. -->
                    <TextBlock Text="{Binding OverlayDescription}" Foreground="{StaticResource OvMuted}" FontSize="11" TextWrapping="Wrap"
                               Background="Transparent">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSpoilerHidden}" Value="True" />
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <BlurEffect Radius="6" />
                                            </Setter.Value>
                                        </Setter>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Style="{StaticResource OvProgress}" Width="120" Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource OvMuted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource OvMuted}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                               Margin="0,2,0,0" Visibility="{Binding Note, Converter={StaticResource EmptyToCollapsed}}" />
                    <!-- The guide tip, four lines at most; blurred like the description of a hidden one. -->
                    <Border BorderBrush="{StaticResource OvAccent}" BorderThickness="2,0,0,0" Padding="6,0,0,0" Margin="0,4,0,0"
                            Visibility="{Binding OverlayTip, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Text="{Binding OverlayTip}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   LineStackingStrategy="BlockLineHeight" LineHeight="14" MaxHeight="56" Background="Transparent">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsTipHidden}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <BlurEffect Radius="6" />
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <Border Background="{StaticResource OvPill}" CornerRadius="8" Padding="7,1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding OverlayBadge}" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverlayBadgeWarns}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource OvWarn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Right"
                                Visibility="{Binding DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Button Content="{local:Tr card.done}" Style="{StaticResource OvButton}"
                                ToolTip="{local:Tr overlay.doneTip}"
                                Visibility="{Binding DataContext.ShowActions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.Main.OverlayMarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="{local:Tr card.toSteam}" Style="{StaticResource OvButton}"
                                ToolTip="{local:Tr overlay.toSteamTip}"
                                Visibility="{Binding DataContext.ShowActions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.Main.OverlayUnlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="{local:Tr overlay.hide}" Style="{StaticResource OvButton}"
                                ToolTip="{local:Tr overlay.hideTip}"
                                Command="{Binding DataContext.Main.OverlayHideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="OverlayPanel" CornerRadius="12" Padding="16,14" Width="440" BorderThickness="1"
            BorderBrush="{StaticResource OvLine}" MouseLeftButtonDown="OnPanelMouseDown">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="3" CornerRadius="2" Background="{StaticResource OvAccent}" Margin="0,2,10,2" />
                    <StackPanel>
                        <TextBlock Text="{Binding Main.GameName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Main.ProgressShort}" Foreground="{StaticResource OvMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <Grid Height="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Main.SegUnlocked}" />
                        <ColumnDefinition Width="{Binding Main.SegManual}" />
                        <ColumnDefinition Width="{Binding Main.SegRest}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="3" CornerRadius="2" Background="{StaticResource OvPill}" />
                    <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{StaticResource OvManual}" />
                    <Border CornerRadius="2" Background="{StaticResource OvAccent}" />
                </Grid>

                <Border Background="#3366C0F4" CornerRadius="6" Padding="10,6" Margin="0,10,0,0"
                        Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Toast}" FontSize="12" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Border Height="1" Background="{StaticResource OvLine}" Margin="0,10,0,6" />
                <TextBlock Text="{Binding ModeHint}" Foreground="{StaticResource OvMuted}" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <TextBlock Text="{local:Tr overlay.missable}" Margin="0,12,0,2" Foreground="{StaticResource OvWarn}" FontWeight="SemiBold" FontSize="11"
                               Visibility="{Binding HasMissable, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Main.OverlayMissable}" ItemTemplate="{StaticResource OverlayItem}" />

                    <TextBlock Text="{local:Tr overlay.nearest}" Margin="0,12,0,2" Foreground="{StaticResource OvAccent}" FontWeight="SemiBold" FontSize="11" />
                    <ItemsControl ItemsSource="{Binding Main.OverlayNearest}" ItemTemplate="{StaticResource OverlayItem}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
